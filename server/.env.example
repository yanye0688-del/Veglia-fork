# Copy to .env and fill in. Never commit your real .env.

# Shared secret between server, phone app, and peek.py. Generate a strong one:
#   head -c 24 /dev/urandom | base64
VEGLIA_TOKEN=change-me-to-a-long-random-string

# Server listen port (default 8513) and bind address.
# Keep the bind on localhost and terminate TLS with nginx/caddy in front.
VEGLIA_PORT=8513
VEGLIA_HOST=127.0.0.1

# Where screenshots are stored, and how many to retain ("peek and burn").
VEGLIA_DATA_DIR=./data
VEGLIA_KEEP=5

# --- peek.py (AI side) ---
# Base URL peek.py uses to reach the server.
VEGLIA_URL=http://127.0.0.1:8513

# Optional: a command run on every new screenshot, given the image path as its
# one argument. This is how the shot reaches YOUR ai as a message. Example:
#   VEGLIA_HOOK=/home/me/notify-my-ai.sh
# VEGLIA_HOOK=
